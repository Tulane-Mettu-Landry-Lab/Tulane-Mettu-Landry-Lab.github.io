<div class="navbar-container">
<nav class="navbar custom-frosted-navbar">
<div class="navbar-brand">
<div class="navbar-item">
<h1 class="is-size-5 has-text-weight-bold"><%= page.paper.abbr %> <%= page.paper.date.year %></h1>
</div>
<a role="button" class="navbar-burger" href="#cite">
<i class="fa-solid fa-quote-right"></i>
</a>
</div>
<div id="navbarMenu" class="navbar-menu">
<div class="navbar-center is-flex-mobile">
<div class="navbar-item is-flex-mobile">
<div class="buttons has-addons is-centered" id="section-indicator-container"></div>
</div>
</div>
<div class="navbar-end" id="link-buttons-container">
<% if (page.links) { %>
  <% page.links.forEach(function(link) { %>
    <a class="navbar-item hover-expand is-small is-dmserif" href="<%= link.link %>">
      <span class="icon" style="margin-right: -5pt;"><i class="<%= link.icon %>"></i></span>
      <span class="text">&nbsp;&nbsp;<%= link.name %></span>
    </a>
  <% }); %>
<% } %>
<a class="navbar-item button is-ghost hover-expand is-link is-outlined is-dmserif" href="#cite">
  <span class="icon" style="margin-right: -5pt;"><i class="fa-solid fa-quote-right"></i></span>
  <span class="text">&nbsp;&nbsp;Cite</span>
</a>
</div>
</div>
</nav>
</div>

<div class="hero is-small">
<nav class="hero-body">
<article class="media">
<%
var paperPageDir = page.path.substring(0, page.path.lastIndexOf('/') + 1);
%>
<span id="top-nav-icon">
<% if (page.paper.pubicon) { %>
  <figure class="media-left">
    <div class="logo-container" style="height:21pt;">
      <img src="<%- page.paper.pubicon.startsWith('/') ? url_for(page.paper.pubicon) : url_for(paperPageDir + page.paper.pubicon.replace('./', '')) %>" style="max-width: auto;height: 100%;display: block;">
    </div>
  </figure>
<% } %>
</span>
<div class="media-content is-hidden-mobile">
<h1 class="subtitle"><%= page.paper.publication %></h1>
</div>
<div class="media-content is-hidden-tablet">
<h1 class="subtitle"><%= page.paper.abbr %></h1>
</div>
</article>
</nav>
</div>

<section class="hero is-bold is-halfheight mt-0">
<div class="hero-body">
<div class="container has-text-left" id="header-title">
<div class="content">
<span id="paper-title-container">
  <h4 class="subtitle" style="font-weight: 400; color: #555;">
    <%= page.paper.date.year %> <%= page.paper.date.month %>
  </h4>
  <h1 class="title mt-0"><%= page.paper.title %></h1>
</span>

<!-- Authors -->
<p id="author-list-container" class="is-dmserif mb-0">
<% if (page.authors) { %>
  <% page.authors.forEach(function(author, index) { %>
    <% if (index > 0) { %> &middot; <% } %>
    <% if (author.link) { %>
      <a href="<%= author.link %>"><strong><%= author.name %></strong></a>
    <% } else { %>
      <strong><%= author.name %></strong>
    <% } %>
    <%
      // Build supTags server-side
      var affilMap = {};
      var counter = 1;
      page.authors.forEach(function(a) {
        if (!affilMap[a.affiliation]) {
          affilMap[a.affiliation] = counter++;
        }
      });
      var num = affilMap[author.affiliation];
      if (num) { %><span class="sup" data-number="<%= num %>"></span><% }
      if (author.equal) { %><span class="sup" data-symbol="plus"></span><% }
      if (author.corresponding) { %><span class="sup" data-symbol="star"></span><% }
    %>
  <% }); %>
<% } %>
</p>

<!-- Affiliation explanations -->
<p id="affiliation-explanation-container" class="is-dmserif">
<%
  if (page.authors) {
    var usedLabels = { plus: false, star: false };
    var affilMap2 = {};
    var ctr = 1;
    page.authors.forEach(function(a) {
      if (a.equal) usedLabels.plus = true;
      if (a.corresponding) usedLabels.star = true;
      if (!affilMap2[a.affiliation]) {
        affilMap2[a.affiliation] = ctr++;
      }
    });
    var sortedAffils = Object.keys(affilMap2).sort(function(a, b) {
      return affilMap2[a] - affilMap2[b];
    });
    sortedAffils.forEach(function(affil) {
%>
  <span class="sup" data-number="<%= affilMap2[affil] %>"></span><%= affil %><br>
<%
    });
    if (usedLabels.plus) { %><span class="sup" data-symbol="plus"></span>Equal Contribution(s)<br><% }
    if (usedLabels.star) { %><span class="sup" data-symbol="star"></span>Corresponding Author(s)<br><% }
  }
%>
</p>

<!-- Link buttons header -->
<p id="link-buttons-header-container">
  <% if (page.links) { %>
    <div class="buttons has-addons is-dmserif">
      <% page.links.forEach(function(link) {
        var expandTag = link.expand ? '' : 'hover-expand';
      %>
        <a class="button is-small is-rounded frosted-button <%= expandTag %>" href="<%= link.link %>">
          <span class="icon" style="margin-right: -5pt;"><i class="<%= link.icon %>"></i></span>
          <span class="text">&nbsp;&nbsp;<%= link.name %></span>
        </a>
      <% }); %>
      <a class="button is-small is-rounded frosted-button hover-expand is-link is-outlined" href="#cite">
        <span class="icon" style="margin-right: -5pt;"><i class="fa-solid fa-quote-right"></i></span>
        <span class="text">&nbsp;&nbsp;Cite</span>
      </a>
    </div>
  <% } %>
</p>
</div>

<nav class="breadcrumb is-small">
<ul id="breadcrumb-container">
<%
  if (page.nav) {
    var entries = Object.entries(page.nav);
    entries.forEach(function(entry, idx) {
      var label = entry[0];
      var href = entry[1];
      if (idx === entries.length - 1 || href === null) {
%>
  <li class="is-active"><a aria-current="page"><%= label %></a></li>
<%    } else { %>
  <li><a href="<%= href %>"><%= label %></a></li>
<%    }
    });
  }
%>
</ul>
</nav>

</div>
</div>
</section>

<!-- Post-process content to fix relative image paths -->
<!-- Hexo resolves markdown relative paths as root-relative, but we need page-relative -->
<% var fixedContent = page.content; %>
<% if (paperPageDir) { %>
<%   // Fix images that Hexo resolved as root-relative (e.g., src="/images/intro.png" -> src="/papers/SLUG/images/intro.png") %>
<%   // Only fix paths under /images/, /figures/, /figs/ etc. that aren't under /assets/ or /css/ %>
<%   var imgRegex = new RegExp('src="(?!https?:\\/\\/|\\/assets\\/|\\/css\\/|\\/js\\/)(\\/[^"]*)"', 'g'); %>
<%   fixedContent = fixedContent.replace(imgRegex, function(match, p1) { return 'src="' + url_for(paperPageDir.replace(/\/$/, '') + p1) + '"'; }); %>
<% } %>
<section class="section">
<div class="container is-max-desktop">
<div class="content" id="markdown-output-container">
  <%- fixedContent %>
</div>
</div>
</section>

<section class="section">
<div class="container is-max-desktop">
<h2 class="title is-4" id="cite">Cite This Work</h2>
<div class="grid has-3-cols">
<div class="cell is-col-span-2">
  <div class="tabs mb-0" id="citation-tabs">
    <ul>
      <% if (page.citations) {
        var first = true;
        Object.keys(page.citations).forEach(function(name) {
      %>
        <li<%= first ? ' class="is-active"' : '' %>><a href="#" data-tab="<%= name %>"><%= name %></a></li>
      <%
          first = false;
        });
      } %>
    </ul>
  </div>
  <pre id="citation-content" class="is-mono"><%= page.citations ? Object.values(page.citations)[0] : '' %></pre>
</div>
<div class="cell has-text-centered is-flex is-justify-content-center is-align-items-center">
  <div id="share-col"></div>
</div>
</div>
</div>
</section>

<footer class="footer">
<div class="content has-text-centered">
<p id="footer-note-container"><%= page.document ? page.document.footer : '' %></p>
<p>Build <a href="https://github.com/Jiarui0923/paperpage">PaperPage</a> for your paper.</p>
<a id="theme-toggle" class="button">
  <span class="icon"><i class="fa-solid fa-circle-half-stroke"></i></span>
</a>
</div>
</footer>

<!-- Section Navigation & Citation JS -->
<script>
(function() {
  var sectionData = [];
  var isSectionDataReady = false;
  var scrollTimeout;
  var citations = <%- JSON.stringify(page.citations || {}) %>;

  // Citation tabs
  document.querySelectorAll('#citation-tabs a').forEach(function(a) {
    a.addEventListener('click', function(e) {
      e.preventDefault();
      var tabName = this.dataset.tab;
      document.querySelectorAll('#citation-tabs li').forEach(function(li) { li.classList.remove('is-active'); });
      this.parentElement.classList.add('is-active');
      document.getElementById('citation-content').textContent = citations[tabName] || '';
    });
  });

  // Slugify helper
  function slugify(text) {
    return text.toLowerCase().trim().replace(/[\s\W-]+/g, '-').replace(/^-+|-+$/g, '');
  }

  // Extract headings
  function extractSections() {
    sectionData = [];
    var mainContent = document.getElementById('markdown-output-container');
    var scrollOffset = 150;
    var usedIds = {};
    if (mainContent) {
      mainContent.querySelectorAll('h1, h2, h3').forEach(function(heading) {
        var text = heading.textContent.trim();
        if (!text) return;
        var id = heading.id;
        if (!id || usedIds[id]) {
          id = slugify(text);
          var uniqueId = id, counter = 1;
          while (usedIds[uniqueId]) { uniqueId = id + '-' + (counter++); }
          id = uniqueId;
          heading.id = id;
        }
        usedIds[id] = true;
        var rect = heading.getBoundingClientRect();
        sectionData.push({ id: id, title: text, offsetTop: rect.top + window.scrollY - scrollOffset });
      });
    }
    sectionData.sort(function(a, b) { return a.offsetTop - b.offsetTop; });
    isSectionDataReady = sectionData.length > 0;
    updateSectionIndicator();
  }

  function updateSectionIndicator() {
    var container = document.getElementById('section-indicator-container');
    if (!isSectionDataReady || !container) return;
    clearTimeout(scrollTimeout);
    scrollTimeout = setTimeout(function() {
      var currentScroll = window.scrollY;
      var activeIndex = 0;
      for (var i = sectionData.length - 1; i >= 0; i--) {
        if (currentScroll >= sectionData[i].offsetTop) { activeIndex = i; break; }
      }
      var curr = sectionData[activeIndex];
      var prev = sectionData[activeIndex - 1];
      var next = sectionData[activeIndex + 1];
      var html = '';
      if (prev) html += '<a class="button is-ghost section-nav-link is-prev" href="#' + prev.id + '"><i class="fa-solid fa-arrow-left"></i></a>';
      html += '<a class="button is-ghost section-nav-link is-active" href="#' + curr.id + '">' + curr.title.toUpperCase() + '</a>';
      if (next) html += '<a class="button is-ghost section-nav-link is-next" href="#' + next.id + '"><i class="fa-solid fa-arrow-right"></i></a>';
      if (container.dataset.activeId !== curr.id) {
        container.innerHTML = html;
        container.dataset.activeId = curr.id;
      }
    }, 50);
  }

  // QR Code
  try {
    new QRCode(document.getElementById('share-col'), {
      text: window.location.href,
      width: 200,
      height: 200,
      colorDark: "#000000",
      colorLight: "#ffffff",
      correctLevel: QRCode.CorrectLevel.H
    });
  } catch(e) {}

  // Init
  extractSections();
  window.addEventListener('scroll', updateSectionIndicator);
  window.addEventListener('resize', extractSections);
})();
</script>